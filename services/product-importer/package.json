{
  "name": "@nyan-stock/product-importer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "import:products": "tsx src/scripts/importProducts.ts",
    "import:seed-csv": "tsx src/scripts/importFromSeedCsv.ts",
    "import:keyword": "tsx src/scripts/importByKeyword.ts",
    "import:jan": "tsx src/scripts/importByJanCode.ts",
    "prune:seed-csv": "tsx src/scripts/pruneProductMastersToSeedCsv.ts",
    "dedupe": "tsx src/scripts/dedupeProducts.ts",
    "export:mobile-seed": "tsx src/scripts/exportMobileSeed.ts",
    "export:csv": "tsx src/scripts/exportProductMasterCsv.ts",
    "quality:products": "tsx src/scripts/checkProductMasterQuality.ts",
    "build:pet-master": "tsx src/scripts/buildPetProductMaster.ts",
    "apply:pet-master-verifications": "tsx src/scripts/applyPetMasterVerificationsToLegacySeed.ts",
