# Copy this file to .env.development.local for local Expo development.
# Use the URL and publishable/anon key from the separate development Supabase project.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Use nyanstock://auth/callback for a development build. Leave blank when using
# Expo Go and configure the generated exp:// callback URL in Supabase instead.
EXPO_PUBLIC_SUPABASE_AUTH_REDIRECT_URL=
# OAuth callback handling uses the authorization-code flow with PKCE.
EXPO_PUBLIC_SUPABASE_AUTH_FLOW_TYPE=pkce

EXPO_PUBLIC_SUPABASE_PET_PRODUCT_MASTER_TABLE=pet_product_masters
EXPO_PUBLIC_SUPABASE_SUPPORT_INQUIRIES_TABLE=support_inquiries
EXPO_PUBLIC_SUPABASE_ICON_BUCKET=icons
EXPO_PUBLIC_PURCHASE_LINK_SEARCH_FUNCTION_URL=
EXPO_PUBLIC_SUPABASE_HOUSEHOLD_SNAPSHOTS_TABLE=household_snapshots
EXPO_PUBLIC_SUPABASE_HOUSEHOLDS_TABLE=households
EXPO_PUBLIC_SUPABASE_HOUSEHOLD_CATS_TABLE=household_cats
EXPO_PUBLIC_SUPABASE_HOUSEHOLD_INVENTORY_ITEMS_TABLE=household_inventory_items
EXPO_PUBLIC_SUPABASE_HOUSEHOLD_PURCHASE_HISTORY_TABLE=household_purchase_history
