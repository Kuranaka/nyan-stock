{
  "expo": {
    "name": "にゃんストック",
    "slug": "nyan-stock",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "nyanstock",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFDF8"
    },
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.nyanstock.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "JANコードを読み取り、猫用品の在庫登録を補助するためにカメラを使用します。",
        "NSPhotoLibraryUsageDescription": "猫や商品のアイコン画像を選択するために写真ライブラリを使用します。"
      }
    },
    "android": {
      "package": "com.nyanstock.app",
      "versionCode": 1,
      "permissions": ["CAMERA"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFF7E8"
      }
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-camera",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "猫や商品のアイコン画像を選択するために写真ライブラリを使用します。"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
