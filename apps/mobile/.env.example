EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Expo Goでは空のままにすると exp://.../--/auth/callback が使われます。
# Supabase側でexp://をRedirect URLsに入れてもSite URLへ戻る場合は、
# dev build / releaseで EXPO_PUBLIC_SUPABASE_AUTH_REDIRECT_URL=nyanstock://auth/callback を使ってください。
EXPO_PUBLIC_SUPABASE_AUTH_REDIRECT_URL=
# Expo GoでOAuth確認する場合はimplicit推奨。dev build / releaseでPKCEに戻す場合はpkceを設定します。
EXPO_PUBLIC_SUPABASE_AUTH_FLOW_TYPE=implicit
EXPO_PUBLIC_SUPABASE_PRODUCT_MASTER_TABLE=product_masters
EXPO_PUBLIC_SUPABASE_PRODUCT_MASTER_SUGGESTIONS_TABLE=product_master_suggestions
EXPO_PUBLIC_SUPABASE_SUPPORT_INQUIRIES_TABLE=support_inquiries
EXPO_PUBLIC_SUPABASE_ICON_BUCKET=icons
EXPO_PUBLIC_PURCHASE_LINK_SEARCH_FUNCTION_URL=
EXPO_PUBLIC_SUPABASE_HOUSEHOLD_SNAPSHOTS_TABLE=household_snapshots
EXPO_PUBLIC_SUPABASE_HOUSEHOLDS_TABLE=households
EXPO_PUBLIC_SUPABASE_HOUSEHOLD_CATS_TABLE=household_cats
EXPO_PUBLIC_SUPABASE_HOUSEHOLD_INVENTORY_ITEMS_TABLE=household_inventory_items
EXPO_PUBLIC_SUPABASE_HOUSEHOLD_PURCHASE_HISTORY_TABLE=household_purchase_history
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_ENABLE_ANDROID=false
EXPO_PUBLIC_REVENUECAT_PLUS_ENTITLEMENT_ID=nyanstock_plus
EXPO_PUBLIC_REVENUECAT_DEBUG_LOGS=false
