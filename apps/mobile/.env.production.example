# Configure these values in the EAS "production" environment. Do not commit
# actual keys or the production project reference.
EXPO_PUBLIC_APP_ENV=production
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Build-time validation only. Set this to the project reference in the
# production Supabase URL so a development project cannot be selected by mistake.
RELEASE_SUPABASE_PROJECT_REF=
EXPO_PUBLIC_SUPABASE_AUTH_REDIRECT_URL=nyanstock://auth/callback
# Store builds use PKCE. Leaving this unset also defaults to PKCE in the app.
EXPO_PUBLIC_SUPABASE_AUTH_FLOW_TYPE=pkce

EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_ENABLE_ANDROID=false
EXPO_PUBLIC_REVENUECAT_PLUS_ENTITLEMENT_ID=nyanstock_plus
EXPO_PUBLIC_REVENUECAT_DEBUG_LOGS=false
EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID=
