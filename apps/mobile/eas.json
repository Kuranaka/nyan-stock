{
  "cli": {
    "version": ">= 20.5.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "environment": "development"
    },
    "testflight": {
      "distribution": "store",
      "autoIncrement": true,
      "credentialsSource": "local",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_SUPABASE_AUTH_FLOW_TYPE": "pkce"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_SUPABASE_AUTH_FLOW_TYPE": "pkce"
      }
    }
  },
  "submit": {
    "testflight": {},
    "production": {}
  }
}
